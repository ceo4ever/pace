   139	export function orphanRecords(target: string, entries: readonly LedgerEntry[]): string[] {
   140	  const dir = join(dirname(target), RECORDS_DIR);
   141	  if (!existsSync(dir)) return [];
   142	  let names: string[];
   143	  try { names = readdirSync(dir); } catch (error) { throw new LedgerError(`검토 기록 폴더를 읽을 수 없다: ${dir} — ${(error as Error).message}`); }
   144	  const known = new Set(entries.filter((e): e is ReviewEntry => e.type === "review").map((e) => e.record));
   145	  // 번호 순(R9 다음 R10)으로 복구해야 기준점 순서가 맞다
   146	  return names.filter((n) => /^R\d+\.json$/.test(n)).sort((x, y) => Number(x.slice(1, -5)) - Number(y.slice(1, -5))).map((n) => `${RECORDS_DIR}/${n}`).filter((n) => !known.has(n));
   147	}
