   117	export function acquireLock(target: string): () => void {
   118	  const file = lockPath(target);
   119	  const create = (): number => openSync(file, "wx");
   120	  let fd: number;
   121	  try { fd = create(); } catch (error) {
   122	    if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw new LedgerError(`검토 잠금을 만들 수 없다: ${file} — ${(error as Error).message}`);
   123	    // 잠금을 만든 프로세스가 이미 없으면(중단) 남은 잠금이다 — 치우고 한 번 다시 시도한다
   124	    if (!staleLock(file)) throw new LedgerError(`같은 대상의 검토가 진행 중이다(잠금 ${file}). 진행 중인 검토가 없으면 잠금 파일을 지우고 다시 실행한다`);
   125	    try { rmSync(file, { force: true }); fd = create(); } catch { throw new LedgerError(`같은 대상의 검토가 진행 중이다(잠금 ${file})`); }
   126	  }
   127	  try { writeSync(fd, String(process.pid)); } finally { closeSync(fd); }
   128	  return () => { try { rmSync(file, { force: true }); } catch { /* 잠금 정리 실패는 다음 실행이 알린다 */ } };
   129	}
   130	
   131	function staleLock(file: string): boolean {
   132	  let pid: number;
   133	  try { pid = Number(readFileSync(file, "utf8").trim()); } catch { return false; }
   134	  if (!Number.isInteger(pid) || pid <= 0) return false; // 내용을 모르면 진행 중으로 본다
   135	  try { process.kill(pid, 0); return false; } catch (error) { return (error as NodeJS.ErrnoException).code === "ESRCH"; }
   136	}
