   100	/** 같은 대상(폴더 기준 이름)의 단계. 순수 함수 */
   101	export function reviewStage(entries: readonly LedgerEntry[], targetName: string): StageInfo {
   102	  const mine = entries.filter((e) => e.target === targetName);
   103	  let start = 0; // 마지막 pass·decision 다음
   104	  mine.forEach((e, i) => { if ((e.type === "review" && e.verdict === "pass") || e.type === "decision") start = i + 1; });
   105	  const segment = mine.slice(start);
   106	  const fails = segment.filter((e) => e.type === "review" && e.verdict === "fail").length;
   107	  const diagIndex = segment.map((e) => e.type).lastIndexOf("diagnosis");
   108	  const afterDiag = diagIndex < 0 ? segment : segment.slice(diagIndex + 1);
   109	  const base = [...afterDiag].reverse().find((e): e is ReviewEntry => e.type === "review" && e.verdict === "fail" && e.interrupted !== true) ?? null;
   110	  let stage: Stage = "normal";
   111	  if (diagIndex < 0) { if (fails >= DIAGNOSE_AFTER) stage = "diagnose"; }
   112	  else if (afterDiag.some((e) => e.type === "review" && e.verdict === "fail")) stage = "ask_user";
   113	  return { stage, consecutive_fails: fails, base };
   114	}
