+  assert.equal(h.prompts.length, runs);
+  rmSync(join(h.dir, "REVIEW-LOG.lock"));
+  if (process.platform !== "win32") {
+    mkdirSync(join(h.dir, "REVIEW-LOG.jsonl")); // 파일 자리에 폴더 — 읽기 단계에서 멈춘다
