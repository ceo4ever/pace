+  return names.filter((n) => /^R\d+\.json$/.test(n)).sort((x, y) => Number(x.slice(1, -5)) - Number(y.slice(1, -5))).map((n) => `${RECORDS_DIR}/${n}`).filter((n) => !known.has(n));
