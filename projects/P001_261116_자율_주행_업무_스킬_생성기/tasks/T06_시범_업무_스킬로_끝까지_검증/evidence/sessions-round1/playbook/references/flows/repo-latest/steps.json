{
 "title": "공개 GitHub 저장소 페이지에서 기본 브랜치·별 개수·최신 커밋(해시 앞 7자·제목·날짜)을 읽어 표로 낸다",
 "updated": "2026-11-16",
 "base": "references/flows/repo-latest",
 "purpose": "공개 GitHub 저장소 페이지에서 기본 브랜치·별 개수·최신 커밋(해시 앞 7자·제목·날짜)을 읽어 표로 낸다",
 "agentView": true,
 "rules": [],
 "resultTo": "result-table",
 "allowedOrigins": [
  "https://github.com"
 ],
 "allowedPaths": [
  "/{owner}/{repo}"
 ],
 "steps": [
  {
   "id": "S01",
   "title": "저장소 페이지 열기",
   "risk": "read",
   "lane": "both",
   "tool": "orca",
   "command": "orca tab create --url https://github.com/<owner/repo>",
   "purpose": "입력한 공개 저장소의 첫 화면을 연다",
   "enter": "새 탭이 열려 있다",
   "identify": {
    "title": "저장소 첫 화면",
    "anchors": [
     "저장소 이름 머리글이 보인다",
     "Code 탭이 보인다"
    ]
   },
   "screen": {
    "url": "^/[^/]+/[^/]+/?$",
    "require": [
     "[data-testid=\"repo-name-link\"]"
    ],
    "forbid": []
   },
   "elements": [],
   "success": "저장소 페이지가 열려 머리글에 저장소 이름이 보인다",
   "escalate": "404가 나오거나 로그인을 요구한다",
   "capture": false,
   "captureNote": "열기만 하는 단계라 기준 화면은 다음 단계에서 찍는다",
   "status": "todo"
  },
  {
   "id": "S02",
   "title": "저장소 요약 읽기",
   "risk": "read",
   "lane": "forward",
   "tool": "orca",
   "purpose": "기본 브랜치·별 개수·최신 커밋을 화면에서 읽는다",
   "enter": "S01 성공",
   "identify": {
    "title": "저장소 첫 화면",
    "anchors": [
     "최신 커밋 줄이 보인다",
     "별(Star) 단추가 보인다"
    ]
   },
   "screen": {
    "url": "^/[^/]+/[^/]+/?$",
    "require": [
     "[data-testid=\"latest-commit\"]"
    ],
    "forbid": []
   },
   "elements": [
    {
     "n": 1,
     "label": "기본 브랜치",
     "find": "#ref-picker-repos-header-ref-selector",
     "action": "읽기",
     "wait": "없음",
     "expect": "브랜치 이름이 보인다",
     "onChange": "멈춘다"
    },
    {
     "n": 2,
     "label": "별 개수",
     "find": "[data-testid=\"star-button\"]",
     "action": "읽기",
     "wait": "없음",
     "expect": "Star 옆에 개수가 보인다(예 124k)",
     "onChange": "멈춘다"
    },
    {
     "n": 3,
     "label": "최신 커밋 제목",
     "find": "[data-testid=\"latest-commit-html\"]",
     "action": "읽기",
     "wait": "없음",
     "expect": "비어 있지 않다",
     "onChange": "멈춘다"
    },
    {
     "n": 4,
     "label": "최신 커밋 링크",
     "find": "[data-testid=\"latest-commit-details\"] a[href*=\"/commit/\"]",
     "action": "읽기",
     "wait": "없음",
     "expect": "링크 글자가 7자 해시다",
     "onChange": "멈춘다"
    },
    {
     "n": 5,
     "label": "최신 커밋 날짜",
     "find": "[data-testid=\"latest-commit-details\"] relative-time",
     "action": "읽기",
     "wait": "없음",
     "expect": "datetime 속성(UTC 시각)이 있다",
     "onChange": "멈춘다"
    }
   ],
   "maskRequire": [
    "[data-testid=\"latest-commit\"]"
   ],
   "extract": [
    {
     "name": "기본 브랜치",
     "where": {
      "selector": "#ref-picker-repos-header-ref-selector"
     },
     "format": "문자열",
     "sensitivity": "public",
     "deliverTo": "result-table",
     "verify": "비어 있지 않음"
    },
    {
     "name": "별 개수",
     "where": {
      "selector": "[data-testid=\"star-button\"]"
     },
     "format": "문자열",
     "sensitivity": "public",
     "deliverTo": "result-table",
     "verify": "숫자 또는 k·m 표기"
    },
    {
     "name": "최신 커밋 해시",
     "where": {
      "selector": "[data-testid=\"latest-commit-details\"] a[href*=\"/commit/\"]"
     },
     "format": "문자열",
     "sensitivity": "public",
     "deliverTo": "result-table",
     "verify": "링크 글자(7자 해시) — 링크 주소 끝 전체 해시의 앞 7자와 같다"
    },
    {
     "name": "최신 커밋 제목",
     "where": {
      "selector": "[data-testid=\"latest-commit-html\"]"
     },
     "format": "문자열",
     "sensitivity": "public",
     "deliverTo": "result-table",
     "verify": "비어 있지 않음"
    },
    {
     "name": "최신 커밋 날짜",
     "where": {
      "selector": "[data-testid=\"latest-commit-details\"] relative-time"
     },
     "format": "문자열",
     "sensitivity": "public",
     "deliverTo": "result-table",
     "verify": "datetime 속성의 UTC 날짜"
    }
   ],
   "success": "다섯 값이 모두 읽힌다",
   "escalate": "선택자가 하나라도 없다 — 화면이 바뀐 것이다",
   "status": "captured",
