     "2": "[data-testid=\"star-button\"]",
     "3": "[data-testid=\"latest-commit-html\"]",
     "4": "[data-testid=\"latest-commit-details\"] a[href*=\"/commit/\"]",
     "5": "[data-testid=\"latest-commit-details\"] relative-time"
    },
    "contextSha": "9f96ffbc0b3210a4c11ab8df7e9329ea2bf854dd88bf59de8f521be934b10616"
