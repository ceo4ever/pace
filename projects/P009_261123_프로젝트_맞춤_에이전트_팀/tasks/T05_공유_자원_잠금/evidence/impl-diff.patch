+}
+export interface LockResult {
+  outcome: "acquired" | "busy" | "hold" | "released" | "renewed" | "started" | "status";
+  reason: string; code: 0 | 1 | 2; scope: "repo" | "machine"; active?: boolean; lease?: ResourceLease;
