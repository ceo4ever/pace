+  const run = (...args: string[]) => runPace(args, { cwd: root, home, env, timeout: 30000 });
+  assert.equal(run("team", "new", "builder", "--role", "maker").status, 0);
+  git("add", "-A"); git("commit", "-qm", "fixture");
