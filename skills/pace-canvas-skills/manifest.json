  "skills": {
    "canvas-read": {
      "description": "Canvas 문서(.canvas.json)에서 프레임과 요소를 정보(read)와 이미지(render)로 꺼낸다 — 구현·검토 전에 어디에 무엇이 있는지 찾을 때 쓴다. 문서는 읽기만 한다.",
      "requires": "Node 22+; render.mjs는 설치된 Google Chrome(CHROME_PATH)",
      "tools": [
        "read.mjs",
        "render.mjs"
      ]
    },
    "canvas-wireframe": {
      "description": "기획을 좌표 없이 명세(JSON)로 쓰면 편집 가능한 와이어프레임(.canvas.json)을 만들고, 에디터 값으로 정리하고, 겹침·잘림을 검사한다 — 화면 기획·검토용 와이어프레임을 Canvas Studio 문서로 낼 때 쓴다.",
      "requires": "Node 22+; wireframe.mjs·normalize.mjs는 설치된 Google Chrome(CHROME_PATH)",
      "tools": [
        "apply-edits.mjs",
        "check.mjs",
        "components.mjs",
        "edit.mjs",
        "normalize.mjs",
        "validate-spec.mjs",
        "wireframe.mjs"
      ]
    }
  },
