  "canvasEntry": {
   "type": "object",
   "required": [
    "screen",
    "document",
    "frame",
    "state",
    "refs",
    "links"
   ],
   "additionalProperties": false,
   "properties": {
    "screen": {
     "type": "string",
     "pattern": "^SCR-[A-Za-z0-9-]+$"
    },
    "document": {
     "type": "string",
     "minLength": 1
    },
    "frame": {
     "type": "string",
     "minLength": 1,
     "maxLength": 256,
     "pattern": "^[^\\-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
    },
    "state": {
     "type": "string",
     "minLength": 1
    },
    "refs": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^((UC|AC|F)-[A-Za-z0-9-]+|BR[0-9]+)$"
     }
    },
    "links": {
     "type": "array",
     "items": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "element",
         "to"
        ],
        "additionalProperties": false,
        "properties": {
         "element": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
         },
         "to": {
          "type": "object",
          "required": [
           "screen",
           "state"
          ],
          "additionalProperties": false,
          "properties": {
           "screen": {
            "type": "string",
            "pattern": "^SCR-[A-Za-z0-9-]+$"
           },
           "state": {
            "type": "string",
            "minLength": 1
           }
          }
         }
        }
       },
       {
        "type": "object",
        "required": [
         "element",
         "unlinked"
        ],
        "additionalProperties": false,
        "properties": {
         "element": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\-\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$"
         },
         "unlinked": {
          "type": "boolean",
          "enum": [
           true
          ]
         }
        }
       }
      ]
     }
    }
   }
  }
