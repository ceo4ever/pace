 "criteria": [
  {
   "id": "AC-01",
   "given": "주제를 입력했을 때",
   "when": "'기획안 만들기'를 누르면",
   "then": "30초 안에 기획안 3개가 제목·훅·장면 구성과 함께 보인다"
  },
  {
   "id": "AC-02",
   "given": "생성이 실패했을 때",
   "when": "기획안 화면을 보면",
   "then": "실패 이유와 '다시 생성' 버튼이 보이고, 입력한 주제는 그대로 남아 있다"
  },
  {
   "id": "AC-03",
   "given": "주제 칸이 비어 있을 때",
   "when": "추천 칩을 누르면",
   "then": "칩 내용이 주제 칸에 채워진다"
  },
  {
   "id": "AC-04",
   "given": "기획안을 골랐을 때",
   "when": "편집기가 열리면",
   "then": "초안 영상과 장면별 자막이 보인다"
  },
  {
   "id": "AC-05",
   "given": "렌더가 2분을 넘을 때",
   "when": "편집기에 머물면",
   "then": "진행률과 '끝나면 알림' 선택이 보인다"
  },
  {
   "id": "AC-06",
   "given": "영상을 저장했을 때",
   "when": "플랫폼을 골라 발행하거나 예약하면",
   "then": "발행 목록에 상태(대기·완료·실패)가 보인다"
  },
  {
   "id": "AC-07",
   "given": "연결된 채널이 없을 때",
   "when": "발행을 누르면",
   "then": "채널 연결 화면으로 가고, 연결하면 발행 화면으로 돌아온다"
  },
