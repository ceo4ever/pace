{
  "version": 1,
  "checks": [{ "cwd": ".", "command": "npm run typecheck" }],
  "units": [
    {
      "id": "test-runner",
      "sources": ["src/test-runner/**/*.ts", "src/test-runner/*.mjs", "src/test-runner/*.py", "src/project/shell-result.ts"],
      "tests": ["test/test-runner.test.ts", "test/changed-test.test.ts"],
      "runner": { "kind": "node-test", "cwd": "." },
      "requires": []
    },
    {
      "id": "git-fixture",
      "sources": ["test/helpers.ts"],
      "tests": ["test/git-fixture.test.ts"],
      "runner": { "kind": "node-test", "cwd": "." },
      "requires": []
    },
    {
      "id": "intent-preview",
      "sources": ["src/intent/preview.ts", "templates/intent-preview/**/*"],
      "tests": ["test/intent-preview.test.ts", "test/intent-plan.test.ts"],
      "runner": { "kind": "node-test", "cwd": "." },
      "requires": []
    },
    {
      "id": "scout-card",
      "sources": [
        "src/scout/card.ts"
      ],
      "tests": [
        "test/scout-ideas.test.ts",
        "test/cli.test.ts"
      ],
      "runner": {
        "kind": "node-test",
        "cwd": "."
      },
      "requires": []
    },
    {
      "id": "adopt-opal",
      "sources": ["src/project/adopt-opal.ts", "README.md", "docs/README.md"],
      "tests": ["test/adopt-opal.test.ts", "test/adopt-opal-e2e.test.ts", "test/adopt-opal-docs.test.ts"],
      "runner": { "kind": "node-test", "cwd": "." },
      "requires": []
    },
    {
      "id": "team",
      "sources": [
        "src/team/**/*.ts",
        "src/core/worker-tiers.ts",
        "src/project/handoff-*.ts",
        "src/project/team-*.ts",
        "templates/team/**/*"
      ],
      "tests": [
        "test/team.test.ts",
        "test/team-verify.test.ts",
        "test/team-lock.test.ts",
        "test/team-handoff.test.ts",
        "test/team-metrics.test.ts",
        "test/project-role.test.ts",
        "test/worker-settings.test.ts"
      ],
      "runner": {
        "kind": "node-test",
        "cwd": "."
      },
      "requires": []
    }
  ],
  "common": [
    "src/project/harness.ts",
    "src/project/shell-result.ts",
    "src/cli.ts",
    "src/core/**/*.ts",
    "test/helpers.ts",
    "package.json",
    "tsconfig.json",
    "src/memory/**/*.ts",
    "src/profile/**/*.ts"
  ]
}
